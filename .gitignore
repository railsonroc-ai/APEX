# ============================================================
# APEX — ARQUIVOS IGNORADOS PELO GIT
# ============================================================

# Dependências Node.js
node_modules/

# Cache Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Arquivos de ambiente e segredos
.env
*.env
!.env.example

# Banco de dados local / dados persistentes
*.db
*.sqlite
*.sqlite3

# Memórias e dados pessoais
data/memories/*.json

# Backups locais
data/backups/

# Logs e métricas
logs/
metrics/

# PID files
pids/
*.pid

# Distribuições e builds
dist/
build/
*.egg-info/

# Arquivos compactados locais
*.zip
