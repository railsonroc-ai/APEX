[Unit]
Description=APEX Stack (Backend + Local Agent)
After=network.target

[Service]
Type=simple
# Ajuste __APEX_ROOT__ para o diretório real de instalação, por exemplo:
# /home/usuario/APEX 2.0
WorkingDirectory=__APEX_ROOT__
ExecStart=__APEX_ROOT__/start_apex.sh --foreground
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
