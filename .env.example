# ============================================================
# APEX — EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ============================================================

# Ambiente
APP_ENV=development

# Chave de acesso ao APEX
APEX_ACCESS_KEY=

# Chave secreta do Flask
# Obrigatória em produção.
SECRET_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# Limite de tempo para chamadas de IA
AI_DIALOG_TIMEOUT_SECONDS=45

# Diretório de dados
APEX_DATA_DIR=./data
# LLM Gateway
LLM_MAX_RETRIES=1
LLM_IDENTIFICATION_MAX_TOKENS=160
LLM_EVIDENCE_MAX_TOKENS=480
LLM_TUTOR_MAX_TOKENS=1200

# Controle de acesso / quota HTTP
AUTH_RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
