# ============================================================
# APEX — EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ============================================================

# Ambiente
APP_ENV=development

# Chave de acesso ao APEX
APEX_ACCESS_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# Limite de tempo para chamadas de IA
AI_DIALOG_TIMEOUT_SECONDS=45

# Diretório de dados
APEX_DATA_DIR=./data